@page
@model IndexModel
@{
    ViewData["Title"] = "EDI 837 Parser";
}

<div class="text-center">
    <h1 class="display-4">Upload EDI 837 File Here</h1>
    <form method="post" enctype="multipart/form-data">
        <div class="form-group mb-3">
            <label asp-for="UploadedEDIFile" class="edi-file-label form-label">Choose File:</label>
            <input asp-for="UploadedEDIFile" type="file" class="edi-file-input form-control" />
        </div>
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-info mt-3">@Model.Message</div>
        }
        <button type="submit" class="upload-btn btn btn-primary">Upload</button>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Claim ID</th>
                <th>Patient Account #</th>
                <th>Charge Amount</th>
                <th>Facility Type Code</th>
                <th>Facility Code Qualifier</th>
                <th>Claim Frequency Code</th>
                <th>Provider/Supplier Signature Indicator</th>
                <th>Assignment/Plan Participation Code</th>
                <th>Benefits Assignment Certification Indicator</th>
                <th>Release of information Indicator</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var claim in Model.AllClaims)
            {
            <tr>
                <td>@claim.ClaimID</td>
                <td>@claim.PatientAccountNum</td>
                <td>@claim.ClaimChargeAmt.ToString("C")</td>
                <td>@claim.Facility.FacilityTypeCode</td>
                <td>@claim.Facility.FacilityCodeQual</td>
                <td>@claim.Facility.ClaimFreqCode</td>
                <td>@claim.SignatureIndicator</td>
                <td>@claim.ParticipationCode</td>
                <td>@claim.BenefitsAsmntCertIndicator</td>
                <td>@claim.ReleaseInfoIndicator</td>
            </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.edi-file-input').on("change", function () {
                var fileName = $(this).val().split("\\").pop();
                $(this).prev('.edi-file-label').html(fileName);
            });
        });
    </script>
}
